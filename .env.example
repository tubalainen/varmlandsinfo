# Kopiera till .env och anpassa:  cp .env.example .env
# .env läses automatiskt av docker compose och checkas aldrig in i git.

# --- AI-chatt (Ollama) -------------------------------------------------------
# Adress till Ollama. Lämna tomt för att stänga av AI-chatten.
# Basadressen räcker, men en fullständig endpoint som
# http://<värd>:11434/v1/chat/completions fungerar också.
#   Ollama på samma maskin som Docker:  http://host.docker.internal:11434
#   Ollama på en annan dator i nätet:   http://<ip-adress>:11434
OLLAMA_URL=

# Modell som ska användas (måste finnas i Ollama: ollama pull <modell>)
OLLAMA_MODEL=llama3.1:8b

# Kontextfönster i tokens. Större värde ger plats för fler evenemang men kräver mer minne.
OLLAMA_NUM_CTX=16384

# Max antal evenemang som skickas med till modellen per fråga
CHAT_MAX_EVENTS=40

# --- Källor ----------------------------------------------------------------
# Ticketmaster Discovery API. Skaffa en gratis nyckel ("Consumer Key") på
# https://developer.ticketmaster.com. Lämna tomt för att stänga av källan.
TICKETMASTER_API_KEY=

# Sökradie i km kring Värmland. Evenemang filtreras sedan på arenor i Värmland.
TICKETMASTER_RADIUS_KM=150

# Lag vars hemmamatcher hämtas från SHL (lagets kod hos SHL, t.ex. FBK för Färjestad BK)
SHL_TEAM_CODE=FBK

# --- Uppdatering av evenemang ------------------------------------------------
# Tidpunkt för den dagliga uppdateringen (HH:MM, lokal tid)
DAILY_REFRESH_TIME=05:00

# Extra uppdatering var N:e minut (0 = bara daglig uppdatering, annars minst 30)
REFRESH_MINUTES=0

# --- Lagring ------------------------------------------------------------------
# Katalog på värden där hämtad data sparas (skapas automatiskt)
VARMLANDSINFO_DATA=./data

# Användare och grupp som ska äga filerna i datakatalogen (kör `id` för att se dina)
PUID=1000
PGID=1000

# --- Övrigt ------------------------------------------------------------------
# Port på värdmaskinen
VARMLANDSINFO_PORT=7799

# Imagetagg från ghcr.io (latest eller en version, t.ex. 0.0.1)
VARMLANDSINFO_TAG=latest

TZ=Europe/Stockholm
